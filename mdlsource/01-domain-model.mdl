/**
 * RestLab domain model
 *
 * CallLog is the spine: every demo lane writes one per call. Each lane's
 * entities hang off the CallLog that produced them, so the overview page can
 * show "this call produced these objects".
 */

-- WARNING: re-running this script DELETES every entity access rule.
--
-- `create or modify persistent entity` rewrites the entity and drops its
-- access rules with it -- silently, reporting only `Modified entity:`. This
-- script declares no grants, so a re-run leaves 16 entities unprotected and
-- mx check still reports 0 errors. It cost 30 access rules once already
-- (FINDINGS #61).
--
-- ALWAYS run 02-security.mdl after this file.

create module RestLab;

-- ---------------------------------------------------------------- enumerations

create or modify enumeration RestLab."Lane" (
  "Crud" 'CRUD (restful-api.dev)',
  "Catalog" 'Auth + pagination (dummyjson)',
  "Mapping" 'Response mapping (jsonplaceholder)',
  "OpenApi" 'OpenAPI import (petstore)',
  "EdgeCase" 'Errors + auth (httpbingo)',
  "Weather" 'Weather (open-meteo)',
  "Rates" 'Rates (frankfurter, transformed)',
  "Graph" 'Microsoft Graph (mocked)',
  "SharePoint" 'SharePoint read/write (mocked)',
  -- NB: the value cannot be called "Binary" -- reserved word in that position,
  -- and neither "Publish" nor "Contract" can be used either (FINDINGS #60).
  "Files" 'Binary download/upload (httpbingo)',
  "Outbound" 'Message definition export (httpbingo)'
);

/*
 * WHY THE MAPPED ATTRIBUTES BELOW ARE String
 *
 * An inline REST response mapping writes every JSON element with schema type
 * String -- mxcli hardcodes DataTypes$StringType in the value mapping element,
 * and the MDL mapping grammar (Attr = jsonField) has no way to declare a type.
 * Mapping such an element onto an Integer/Decimal/Boolean attribute therefore
 * fails mx check with CE6099 ("Schema data type 'String' is not compatible
 * with attribute ... of type 'Integer'"), even though mxcli check and exec both
 * pass silently.
 *
 * So: every attribute populated DIRECTLY by a REST response mapping is String.
 * Attributes written by a microflow (all of CallLog, and Product.PriceValue)
 * keep their natural type. ACT_Catalog_GetProducts demonstrates the conversion.
 */

-- ---------------------------------------------------------------- call log

/**
 * One row per outbound REST call, written by SUB_LogCall.
 */
@position(100, 100)
create or modify persistent entity RestLab."CallLog" (
  /** Full request URL, including query string */
  "Url": String(500),
  "Method": String(10),
  "StatusCode": Integer,
  /** Wall-clock duration in ms. Decimal because millisecondsBetween() returns Decimal. */
  "DurationMs": Decimal,
  "Success": Boolean,
  "ErrorMessage": String(1000),
  /** Raw response body, kept so the demo page can show it beside the mapping */
  "ResponseBody": String,
  /** Payload after a data transformer reshaped it, when a lane uses one. */
  "TransformedBody": String,
  "Lane": RestLab."Lane",
  /**
   * Plain DateTime set by SUB_LogCall, NOT autocreateddate.
   *
   * An entity with autoowner/autocreateddate members cannot be granted with
   * `read * / write *`: mxcli stores `*` as an explicit per-member list that
   * omits the audit members, and Mendix then fails the build with CE0066
   * ("Entity access is out of date"). Listing them explicitly instead is
   * refused by mxcli's own MDL-SEC01 rule, and UPDATE SECURITY reports
   * "all up to date" either way -- so the only way out is not to use them.
   */
  "Timestamp": DateTime
);

-- ---------------------------------------------------------------- CRUD lane

/**
 * api.restful-api.dev object. Writes to this API really persist, so this lane
 * demonstrates a full create/read/update/delete lifecycle.
 */
@position(450, 100)
create or modify persistent entity RestLab."RestObject" (
  /** Server-assigned id, e.g. "ff8081819ff5b110..." */
  "ExternalId": String(100),
  "Name": String(200)
);

/**
 * The nested "data" object of a RestObject. Split out because the REST response
 * mapping maps nested JSON onto a child entity via an association.
 */
@position(450, 300)
create or modify persistent entity RestLab."RestObjectData" (
  "Year": String(10),
  "Price": String(30),
  "InStock": String(10)
);

-- ---------------------------------------------------------------- catalog lane

/**
 * The dummyjson list envelope: {"products": [...], "total":…, "skip":…, "limit":…}.
 * Non-persistent — it only exists to carry paging counters into the page.
 */
@position(800, 100)
create or modify non-persistent entity RestLab."ProductList" (
  "Total": String(10),
  "Skip": String(10),
  "Limit": String(10)
);

@position(800, 300)
create or modify persistent entity RestLab."Product" (
  "ExternalId": String(20),
  "Title": String(200),
  /** Mapped straight from JSON, hence String -- see the note above. */
  "Price": String(30),
  "Brand": String(100),
  "Category": String(100),
  "Rating": String(30),
  /** Typed copy of Price, parsed by ACT_Catalog_GetProducts. */
  "PriceValue": Decimal
);

-- ---------------------------------------------------------------- mapping lane

@position(1150, 100)
create or modify persistent entity RestLab."Author" (
  "ExternalId": String(20),
  "Name": String(200),
  "Username": String(100),
  "Email": String(200)
);

@position(1150, 300)
create or modify persistent entity RestLab."Post" (
  "ExternalId": String(20),
  "Title": String(300),
  "Body": String
);

-- ---------------------------------------------------------------- openapi lane

@position(1500, 100)
create or modify persistent entity RestLab."Pet" (
  "ExternalId": Long,
  "Name": String(200),
  "Status": String(50)
);

-- ---------------------------------------------------------------- weather lane

/**
 * open-meteo forecast. This is the lane where the document response mapping
 * ACTUALLY populates data end to end: the JSON root is an OBJECT and the
 * nested "current" is an OBJECT too, which is the only shape mxcli's inline
 * mappings can express (every ObjectMappingElement is written with
 * MaxOccurs = 1, so repeating elements do not work -- see FINDINGS.md #19).
 */
@position(1850, 100)
create or modify persistent entity RestLab."WeatherReading" (
  "Latitude": String(30),
  "Longitude": String(30),
  "Timezone": String(60),
  "Elevation": String(30)
);

@position(1850, 300)
create or modify persistent entity RestLab."WeatherCurrent" (
  "Time": String(40),
  "Interval": String(20),
  "Temperature": String(30)
);

-- ---------------------------------------------------------------- rates lane

/**
 * frankfurter.dev exchange rates. The payload uses CURRENCY CODES AS PROPERTY
 * NAMES ({"rates": {"AUD": 1.63, "BRL": 6.03, ...}}) -- property names that are
 * really data values, which no Mendix mapping can address.
 *
 * A JSLT data transformer reshapes that object into an array of {code, value}
 * pairs first, and an import mapping DOCUMENT (bound to a JSON structure) then
 * maps it. Unlike the inline REST mapping, that route handles a repeating
 * element, so every rate lands as its own row -- and the attributes keep their
 * natural types instead of being forced to String.
 */
@position(2200, 100)
create or modify persistent entity RestLab."RateSnapshot" (
  "Base": String(10),
  "RateDate": String(20),
  "Amount": Decimal
);

@position(2200, 300)
create or modify persistent entity RestLab."ExchangeRate" (
  "Code": String(10),
  "Value": Decimal
);

-- ---------------------------------------------------------------- graph lane

/**
 * Microsoft Graph user, from the local Prism mock (specs/msgraph.json).
 *
 * Graph is the enterprise case worth getting right, and GET /me is the shape
 * that works: a single OBJECT at the root, so the document response mapping
 * populates it. Graph COLLECTIONS ({"@odata.context":..., "value":[...]}) do
 * not map -- "value" is a repeating element (FINDINGS #19).
 *
 * "ODataContext" maps the literal JSON field "@odata.context". Note the
 * attribute cannot be called "Context": that is a reserved word (CE7247).
 */
@position(2550, 100)
create or modify persistent entity RestLab."GraphUser" (
  /** The @odata.context annotation Graph returns on every response. */
  "ODataContext": String(200),
  "GraphId": String(50),
  "DisplayName": String(200),
  "Mail": String(200),
  "JobTitle": String(100),
  "OfficeLocation": String(50),
  "UserPrincipalName": String(200)
);

-- ---------------------------------------------------------------- sharepoint lane

/**
 * A SharePoint list item, read through Graph.
 *
 * Split into two entities because Graph nests the user-defined columns under
 * "fields", and a Mendix mapping cannot flatten a nested object onto its
 * parent -- a nested object needs a child entity reached by an association.
 */
@position(2900, 100)
create or modify persistent entity RestLab."SPTask" (
  /** "@odata.etag" -- Graph wants it back in If-Match on a write. */
  "Etag": String(100),
  "SPItemId": String(20),
  "WebUrl": String(400),
  "LastModified": String(40)
);

/**
 * The "fields" object. Column names are SharePoint INTERNAL names, so a space
 * arrives percent-ish encoded as _x0020_ ("Due Date" -> "Due_x0020_Date").
 */
@position(2900, 320)
create or modify persistent entity RestLab."SPTaskFields" (
  "Title": String(200),
  "Status": String(50),
  "AssignedTo": String(100),
  /** from "Due_x0020_Date" */
  "DueDate": String(40),
  /** from "Priority_x0020_Level" */
  "PriorityLevel": String(40)
);

-- ---------------------------------------------------------------- associations

create or modify association RestLab."RestObject_RestObjectData"
  from RestLab."RestObject" to RestLab."RestObjectData" type reference;

create or modify association RestLab."ProductList_Product"
  from RestLab."ProductList" to RestLab."Product" type referenceset;

create or modify association RestLab."Post_Author"
  from RestLab."Post" to RestLab."Author" type reference;

create or modify association RestLab."RestObject_CallLog"
  from RestLab."RestObject" to RestLab."CallLog" type reference;

create or modify association RestLab."Product_CallLog"
  from RestLab."Product" to RestLab."CallLog" type reference;

create or modify association RestLab."Post_CallLog"
  from RestLab."Post" to RestLab."CallLog" type reference;

create or modify association RestLab."Pet_CallLog"
  from RestLab."Pet" to RestLab."CallLog" type reference;

create or modify association RestLab."WeatherReading_WeatherCurrent"
  from RestLab."WeatherReading" to RestLab."WeatherCurrent" type reference;

create or modify association RestLab."WeatherReading_CallLog"
  from RestLab."WeatherReading" to RestLab."CallLog" type reference;

create or modify association RestLab."RateSnapshot_ExchangeRate"
  from RestLab."RateSnapshot" to RestLab."ExchangeRate" type referenceset;

create or modify association RestLab."RateSnapshot_CallLog"
  from RestLab."RateSnapshot" to RestLab."CallLog" type reference;

create or modify association RestLab."GraphUser_CallLog"
  from RestLab."GraphUser" to RestLab."CallLog" type reference;

create or modify association RestLab."SPTask_SPTaskFields"
  from RestLab."SPTask" to RestLab."SPTaskFields" type reference;

create or modify association RestLab."SPTask_CallLog"
  from RestLab."SPTask" to RestLab."CallLog" type reference;
