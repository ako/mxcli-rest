/**
 * Binary download and upload over REST
 *
 * The two directions use different mechanisms, and only one of them has an
 * inline form:
 *
 *   DOWNLOAD  rest call ... returns Mod.FileDoc   (inline, names the entity)
 *   UPLOAD    body: file from $Doc                (REST client document ONLY)
 *
 * There is no file form in the inline REST CALL body clause -- it takes a
 * string template, an expression, or an export mapping -- so a binary upload
 * has to go through a consumed REST service document. And download has to be
 * inline, because that is the only form that says WHICH file-document entity
 * to store into.
 *
 * REQUIRES mxcli with #922 ("store a REST response in a file document"). On
 * merged main the inline `returns Mod.FileDoc` form is a parse error, and the
 * document alternative `response: file as $Doc` is unusable: it yields a
 * variable of type Nothing (CE0041), and a CHANGE on it makes the .mpr
 * unloadable outright. See FINDINGS.md #42.
 *
 * AND: the variable a download produces cannot be CHANGEd -- the activity is
 * written with no entity, and the .mpr stops loading:
 *   "Change in  has an invalid value '' for property Attribute."
 * COMMIT on it is fine. To set attributes, hand it to a microflow whose
 * PARAMETER is typed (SUB_TagDownload below) -- a parameter carries the entity
 * type that the REST result variable does not.
 *
 * httpbingo.org is the target: /image/png returns a real 8 KB PNG and /post
 * echoes what it received, including Content-Length, which is how the upload
 * is verified rather than merely "did not throw".
 */

/**
 * Downloaded bytes. Extends System.FileDocument, which brings Name, Contents,
 * HasContents and Size -- those are platform members, so the access rules below
 * grant them with `read * / write *` rather than naming them.
 */
@position(3250, 100)
create or modify persistent entity RestLab."DownloadedFile" extends System.FileDocument (
  "SourceUrl": String(400),
  "ContentKind": String(60)
);

grant RestLab."Developer" on RestLab."DownloadedFile" (create, read *, write *);
grant RestLab."Administrator" on RestLab."DownloadedFile" (create, delete, read *, write *);

create or modify association RestLab."DownloadedFile_CallLog"
  from RestLab."DownloadedFile" to RestLab."CallLog" type reference;

-- ---------------------------------------------------------------- client

create or modify rest client RestLab."BinaryApi" (
  BaseUrl: 'https://httpbingo.org',
  authentication: none
)
{
  /**
   * Echoes the request back, so Content-Length in the response proves how many
   * bytes actually left Mendix -- and it proves this DOES NOT WORK.
   *
   * `body: file from $Doc` is accepted by check and by mx check, the call
   * returns 200, and what is actually sent is the four bytes `$Doc`: the
   * expression TEXT, not the file. Verified by decoding httpbingo's echo:
   *   data:application/octet-stream;base64,JERvYw==  ->  b'$Doc'  (4 bytes)
   * while the document itself holds 8090 bytes.
   *
   * Cause: writer_rest.go:254 handles FILE in the same branch as TEMPLATE and
   * writes a Rest$StringBody with the expression as a literal value template --
   * `describe` shows it back as `Body: template '$Doc'`. And there is no better
   * type to write: the 11.13 metamodel has only Rest$JsonBody, Rest$StringBody
   * and Rest$ImplicitMappingBody. A consumed REST service cannot carry a binary
   * body at all, so this syntax should be refused rather than silently degraded.
   *
   * Kept as a regression test: when it is fixed, Content-Length becomes 8090.
   * See FINDINGS.md #43.
   */
  operation "UploadFile" {
    method: post,
    path: '/post',
    headers: ('Content-Type' = 'application/octet-stream'),
    body: file from $Doc,
    timeout: 60,
    response: json as $Echo
  }
};

-- ---------------------------------------------------------------- microflows

/**
 * Sets the attributes the download could not. The parameter is typed, so CHANGE
 * resolves the entity here even though it does not on the REST result variable.
 */
create or modify microflow RestLab."SUB_TagDownload" (
  $Doc: RestLab."DownloadedFile",
  $Url: String,
  $Kind: String,
  $FileName: String,
  $Log: RestLab."CallLog"
)
folder 'Lanes/Binary'
begin
  CHANGE $Doc (
    "SourceUrl" = $Url,
    "ContentKind" = $Kind,
    "Name" = $FileName,
    RestLab.DownloadedFile_CallLog = $Log
  );
  COMMIT $Doc;
end;
/

/**
 * DOWNLOAD. The mapped result is the file document itself; Size and
 * HasContents come from System.FileDocument and say whether bytes arrived.
 */
create or modify microflow RestLab."ACT_Binary_Download" ()
returns RestLab."DownloadedFile" as $Doc
folder 'Lanes/Binary'
begin
  declare $Start DateTime = [%CurrentDateTime%];

  -- Inline, because only this form names the target file-document entity.
  $Doc = rest call get 'https://httpbingo.org/image/png'
    header Accept = 'image/png'
    timeout 60
    returns RestLab.DownloadedFile;

  $Log = CALL MICROFLOW RestLab."SUB_LogCall" (
    Url = 'https://httpbingo.org/image/png',
    Method = 'GET',
    StatusCode = 0,
    DurationMs = millisecondsBetween($Start, [%CurrentDateTime%]),
    Success = true,
    ErrorMessage = '',
    ResponseBody = 'binary response stored in a file document',
    Lane = RestLab.Lane.Files
  );

  -- NOT a CHANGE here: see the note at the top of this file.
  CALL MICROFLOW RestLab."SUB_TagDownload" (
    Doc = $Doc,
    Url = 'https://httpbingo.org/image/png',
    Kind = 'image/png',
    FileName = 'httpbingo.png',
    Log = $Log
  );

  RETURN $Doc;
end;
/

/**
 * UPLOAD. Takes a file document and posts its bytes. Round-tripping a file that
 * was just downloaded avoids needing a widget or Java action to get bytes into
 * the document in the first place.
 */
create or modify microflow RestLab."ACT_Binary_Upload" (
  $Doc: RestLab."DownloadedFile"
)
returns RestLab."CallLog" as $Log
folder 'Lanes/Binary'
begin
  declare $Start DateTime = [%CurrentDateTime%];

  send rest request RestLab."BinaryApi"."UploadFile" body $Doc;

  $Log = CALL MICROFLOW RestLab."SUB_LogCall" (
    Url = 'POST https://httpbingo.org/post',
    Method = 'POST',
    StatusCode = $latestHttpResponse/StatusCode,
    DurationMs = millisecondsBetween($Start, [%CurrentDateTime%]),
    Success = true,
    ErrorMessage = '',
    ResponseBody = $latestHttpResponse/Content,
    Lane = RestLab.Lane.Files
  );

  RETURN $Log;
end;
/

/** Download then upload the same bytes -- the round trip in one click. */
create or modify microflow RestLab."ACT_Binary_RoundTrip" ()
folder 'Lanes/Binary'
begin
  $Doc = CALL MICROFLOW RestLab."ACT_Binary_Download" ();
  IF $Doc != empty THEN
    CALL MICROFLOW RestLab."ACT_Binary_Upload" (Doc = $Doc);
  END IF;
end;
/
