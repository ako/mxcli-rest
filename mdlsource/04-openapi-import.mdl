/**
 * PetStore client, generated from the published OpenAPI 3.0 spec.
 *
 * This is mxcli's third REST mechanism: no operations are written by hand —
 * method, path, parameters, headers, body, response type and resource groups
 * (from the spec's `tags`) are all derived, and the spec is stored inside the
 * document for Studio Pro parity.
 *
 * The spec is fetched AT EXECUTION TIME, so this statement needs network.
 *
 * Read-only lane on purpose: petstore3 is shared mutable state. POST /pet
 * returned 500 when probed, and a GET on the id used came back as another
 * user's pet, so writes here are not demonstrable.
 */
create or modify rest client RestLab."PetStoreApi" (
  OpenAPI: 'https://petstore3.swagger.io/api/v3/openapi.json',
  -- The spec's servers[0].url is the RELATIVE '/api/v3', which cannot be a
  -- BaseUrl; without this the import warns and leaves the client unusable.
  BaseUrl: 'https://petstore3.swagger.io/api/v3'
);
