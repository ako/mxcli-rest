/**
 * RestLab security
 *
 * Two module roles. Developer runs demos and reads every call log;
 * Administrator adds delete, so stored demo data can be cleared.
 */

create or modify module role RestLab."Developer"
  description 'Runs any demo, sees all call logs';
create or modify module role RestLab."Administrator"
  description 'Developer, plus manages stored demo data';

-- Developer: create + read/write, no delete.
grant RestLab."Developer" on RestLab."CallLog" (create, read *, write *);
grant RestLab."Developer" on RestLab."RestObject" (create, read *, write *);
grant RestLab."Developer" on RestLab."RestObjectData" (create, read *, write *);
grant RestLab."Developer" on RestLab."ProductList" (create, read *, write *);
grant RestLab."Developer" on RestLab."Product" (create, read *, write *);
grant RestLab."Developer" on RestLab."Author" (create, read *, write *);
grant RestLab."Developer" on RestLab."Post" (create, read *, write *);
grant RestLab."Developer" on RestLab."Pet" (create, read *, write *);

-- Administrator: the same plus delete, for clearing demo data.
grant RestLab."Administrator" on RestLab."CallLog" (create, delete, read *, write *);
grant RestLab."Administrator" on RestLab."RestObject" (create, delete, read *, write *);
grant RestLab."Administrator" on RestLab."RestObjectData" (create, delete, read *, write *);
grant RestLab."Administrator" on RestLab."ProductList" (create, delete, read *, write *);
grant RestLab."Administrator" on RestLab."Product" (create, delete, read *, write *);
grant RestLab."Administrator" on RestLab."Author" (create, delete, read *, write *);
grant RestLab."Administrator" on RestLab."Post" (create, delete, read *, write *);
grant RestLab."Administrator" on RestLab."Pet" (create, delete, read *, write *);

-- Wire the module roles onto user roles. The blank app ships Administrator and
-- User; Developer is new, so it gets a user role and a demo user of its own.
alter user role Administrator add module roles (RestLab."Administrator");
create or modify user role Developer (RestLab."Developer");
