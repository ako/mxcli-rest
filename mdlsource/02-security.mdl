mdl 1;
/**
 * RestLab security
 *
 * Two module roles. Developer runs demos and reads every call log;
 * Administrator adds delete, so stored demo data can be cleared.
 */

create or modify module role RestLab."Developer"
  description 'Runs any demo, sees all call logs';
create or modify module role RestLab."Administrator"
  description 'Developer, plus manages stored demo data';

-- Developer: create + read/write, no delete.
grant create, read *, write * on entity RestLab."CallLog" to RestLab."Developer";
grant create, read *, write * on entity RestLab."RestObject" to RestLab."Developer";
grant create, read *, write * on entity RestLab."RestObjectData" to RestLab."Developer";
grant create, read *, write * on entity RestLab."ProductList" to RestLab."Developer";
grant create, read *, write * on entity RestLab."Product" to RestLab."Developer";
grant create, read *, write * on entity RestLab."Author" to RestLab."Developer";
grant create, read *, write * on entity RestLab."Post" to RestLab."Developer";
grant create, read *, write * on entity RestLab."Pet" to RestLab."Developer";

-- Administrator: the same plus delete, for clearing demo data.
grant create, delete, read *, write * on entity RestLab."CallLog" to RestLab."Administrator";
grant create, delete, read *, write * on entity RestLab."RestObject" to RestLab."Administrator";
grant create, delete, read *, write * on entity RestLab."RestObjectData" to RestLab."Administrator";
grant create, delete, read *, write * on entity RestLab."ProductList" to RestLab."Administrator";
grant create, delete, read *, write * on entity RestLab."Product" to RestLab."Administrator";
grant create, delete, read *, write * on entity RestLab."Author" to RestLab."Administrator";
grant create, delete, read *, write * on entity RestLab."Post" to RestLab."Administrator";
grant create, delete, read *, write * on entity RestLab."Pet" to RestLab."Administrator";

grant create, read *, write * on entity RestLab."WeatherReading" to RestLab."Developer";
grant create, read *, write * on entity RestLab."WeatherCurrent" to RestLab."Developer";
grant create, delete, read *, write * on entity RestLab."WeatherReading" to RestLab."Administrator";
grant create, delete, read *, write * on entity RestLab."WeatherCurrent" to RestLab."Administrator";

-- Wire the module roles onto user roles. The blank app ships Administrator and
-- User; Developer is new, so it gets a user role and a demo user of its own.
alter user role Administrator add module roles (RestLab."Administrator");
-- System.User is required: a user role without a System module role fails the
-- build with CE0156 once security is above Off.
create or modify user role Developer ( ModuleRoles: (RestLab."Developer", System.User) );

grant create, read *, write * on entity RestLab."RateSnapshot" to RestLab."Developer";
grant create, read *, write * on entity RestLab."ExchangeRate" to RestLab."Developer";
grant create, delete, read *, write * on entity RestLab."RateSnapshot" to RestLab."Administrator";
grant create, delete, read *, write * on entity RestLab."ExchangeRate" to RestLab."Administrator";

grant create, read *, write * on entity RestLab."GraphUser" to RestLab."Developer";
grant create, delete, read *, write * on entity RestLab."GraphUser" to RestLab."Administrator";

grant create, read *, write * on entity RestLab."SPTask" to RestLab."Developer";
grant create, read *, write * on entity RestLab."SPTaskFields" to RestLab."Developer";
grant create, delete, read *, write * on entity RestLab."SPTask" to RestLab."Administrator";
grant create, delete, read *, write * on entity RestLab."SPTaskFields" to RestLab."Administrator";

-- Security must be at least PROTOTYPE, or the runtime creates no accounts, the
-- demo users below never appear, and every access rule above is inert.
alter app security ( SecurityLevel: prototype );

-- A demo user for the Developer role. The blank app ships demo users for
-- Administrator and User only, and the stock "User" role carries no RestLab
-- module role, so without this there is no way to log in and see the demos.
create or modify demo user 'demo_developer' ( Password: 'RestLabDemo123', UserRoles: (Developer) );
