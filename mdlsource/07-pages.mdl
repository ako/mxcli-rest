/**
 * RestLab pages
 *
 * Home_Web is the launcher: one card per demo lane, each button firing a call
 * and writing a CallLog row. The call log below it is the shared result view --
 * every lane reports there, with the raw response one click away.
 */

create or replace page RestLab."CallLog_Detail"
(
  params: { $CallLog: RestLab."CallLog" },
  title: 'Call detail',
  layout: Atlas_Core.PopupLayout,
  PopupWidth: 900,
  PopupHeight: 640,
  PopupResizable: true,
  folder: 'Shared'
)
{
  layoutgrid lgDetail {
    row rowDetail {
      column colDetail (desktopwidth: autofill) {
  dataview dvLog (datasource: $CallLog) {
    textbox tbUrl (label: 'URL', attribute: Url, editable: false)
    textbox tbMethod (label: 'Method', attribute: Method, editable: false)
    textbox tbStatus (label: 'HTTP status', attribute: StatusCode, editable: false)
    textbox tbDuration (label: 'Duration (ms)', attribute: DurationMs, editable: false)
    checkbox cbSuccess (label: 'Succeeded', attribute: Success, editable: false)
    textbox tbError (label: 'Error', attribute: ErrorMessage, editable: false)
    textarea taBody (label: 'Raw response', attribute: ResponseBody, editable: false)
    textarea taShaped (label: 'After data transformer', attribute: TransformedBody, editable: false)
    actionbutton btnClose (caption: 'Close', action: close_page)
  }
      }
    }
  }
}

create or replace page RestLab."Home_Web"
(
  title: 'RestLab',
  layout: Atlas_Core.Atlas_Default
)
{
  container cIntro (class: 'mx-spacing-bottom-large') {
    header hdr (caption: 'RestLab') {
      dynamictext dtIntro (
        Content: 'Each button fires one live REST call and writes a row to the call log below. Open a row to see the raw response beside the mapped result.'
      )
    }
  }

  layoutgrid lgLanes {
    row rowA {
      column colCrud (desktopwidth: 4) {
        container cCrud (class: 'card') {
          container cdtCrudTitle { dynamictext dtCrudTitle (Content: 'CRUD - api.restful-api.dev', class: 'h4') }
          container cdtCrudBody (class: 'mx-spacing-bottom-medium') { dynamictext dtCrudBody (Content: 'The one public demo API whose writes really persist. List maps a nested data object onto a child entity.') }
          actionbutton btnCrudList (
            caption: 'List objects',
            action: microflow RestLab."ACT_Demo_CrudList",
            buttonstyle: primary
          )
          actionbutton btnCrudGet (
            caption: 'Get object 7',
            action: microflow RestLab."ACT_Demo_CrudGet"
          )
          actionbutton btnCrudCreate (
            caption: 'Create object',
            action: microflow RestLab."ACT_Demo_CrudCreate",
            buttonstyle: success
          )
        }
      }
      column colCatalog (desktopwidth: 4) {
        container cCatalog (class: 'card') {
          container cdtCatTitle { dynamictext dtCatTitle (Content: 'Auth + pagination - dummyjson.com', class: 'h4') }
          container cdtCatBody (class: 'mx-spacing-bottom-medium') { dynamictext dtCatBody (Content: 'A paged envelope mapped onto ProductList + Product, showing the nested LIST mapping and the String-to-Decimal conversion.') }
          actionbutton btnCatalog (
            caption: 'Get 10 products',
            action: microflow RestLab."ACT_Demo_Catalog",
            buttonstyle: primary
          )
        }
      }
      column colBlog (desktopwidth: 4) {
        container cBlog (class: 'card') {
          container cdtBlogTitle { dynamictext dtBlogTitle (Content: 'Response mapping - jsonplaceholder', class: 'h4') }
          container cdtBlogBody (class: 'mx-spacing-bottom-medium') { dynamictext dtBlogBody (Content: 'Flat, predictable JSON. Read-only on purpose: writes here are faked and never persist.') }
          actionbutton btnBlog (
            caption: 'Get posts',
            action: microflow RestLab."ACT_Demo_Blog",
            buttonstyle: primary
          )
        }
      }
    }
    row rowB {
      column colEdge (desktopwidth: 6) {
        container cEdge (class: 'card') {
          container cdtEdgeTitle { dynamictext dtEdgeTitle (Content: 'Errors + auth - httpbingo.org', class: 'h4') }
          container cdtEdgeBody (class: 'mx-spacing-bottom-medium') { dynamictext dtEdgeBody (Content: 'Called inline rather than through the REST client document, because SEND REST REQUEST aborts on a non-2xx response and cannot show a failure.') }
          actionbutton btnEdge404 (
            caption: 'Force a 404',
            action: microflow RestLab."ACT_Demo_EdgeCase404",
            buttonstyle: warning
          )
          actionbutton btnEdge503 (
            caption: 'Force a 503',
            action: microflow RestLab."ACT_Demo_EdgeCase503",
            buttonstyle: danger
          )
        }
      }
      column colWeather (desktopwidth: 6) {
        container cWeather (class: 'card') {
          container cdtWxTitle { dynamictext dtWxTitle (Content: 'Raw JSON - open-meteo', class: 'h4') }
          container cdtWxBody (class: 'mx-spacing-bottom-medium') { dynamictext dtWxBody (Content: 'The only lane whose document response mapping really populates entities: object root, nested object, query parameters. Compare it with the raw-JSON call beside it.') }
          actionbutton btnWeatherMapped (
            caption: 'Get forecast (mapped)',
            action: microflow RestLab."ACT_Demo_WeatherMapped",
            buttonstyle: primary
          )
          actionbutton btnWeather (
            caption: 'Get forecast (raw JSON)',
            action: microflow RestLab."ACT_Demo_Weather"
          )
        }
      }
    }
    row rowSP {
      column colSP (desktopwidth: 12) {
        container cSP (class: 'card') {
          container cdtSPTitle { dynamictext dtSPTitle (Content: 'SharePoint read + write - local Prism mock', class: 'h4') }
          container cdtSPBody (class: 'mx-spacing-bottom-medium') { dynamictext dtSPBody (Content: 'Needs: prism mock -p 4025 -h 127.0.0.1 specs/sharepoint.json. Read one item maps the nested fields object onto a child entity, including the _x0020_ encoded column names. The list is transformed instead. The writes are inline calls, and the mock validates the body against the contract - so a 201 or 200 in the log means the JSON Mendix sent was actually correct.') }
          actionbutton btnSPGet (caption: 'Read item 12 (mapped)', action: microflow RestLab."ACT_Demo_SPGet", buttonstyle: primary)
          actionbutton btnSPList (caption: 'Read list (transformed)', action: microflow RestLab."ACT_Demo_SPList")
          actionbutton btnSPCreate (caption: 'Create item (POST)', action: microflow RestLab."ACT_Demo_SPCreate", buttonstyle: success)
          actionbutton btnSPUpdate (caption: 'Update status (PATCH)', action: microflow RestLab."ACT_Demo_SPUpdate", buttonstyle: warning)
        }
      }
    }
    row rowGraph {
      column colGraph (desktopwidth: 12) {
        container cGraph (class: 'card') {
          container cdtGraphTitle { dynamictext dtGraphTitle (Content: 'Microsoft Graph - local Prism mock', class: 'h4') }
          container cdtGraphBody (class: 'mx-spacing-bottom-medium') { dynamictext dtGraphBody (Content: 'Needs the mock running: prism mock -p 4020 -h 127.0.0.1 specs/msgraph.json. GET /me is a single object, so the response mapping populates GraphUser - including the @odata.context annotation. GET /users is an OData collection whose value array cannot be mapped, so it is called inline with a bearer token and reshaped by a JSLT transformer instead.') }
          actionbutton btnGraphMe (
            caption: 'GET /me (mapped)',
            action: microflow RestLab."ACT_Demo_GraphMe",
            buttonstyle: primary
          )
          actionbutton btnGraphUsers (
            caption: 'GET /users (transformed)',
            action: microflow RestLab."ACT_Demo_GraphUsers"
          )
        }
      }
    }
    row rowC {
      column colRates (desktopwidth: 12) {
        container cRates (class: 'card') {
          container cdtRatesTitle { dynamictext dtRatesTitle (Content: 'Data transformer - frankfurter.dev', class: 'h4') }
          container cdtRatesBody (class: 'mx-spacing-bottom-medium') { dynamictext dtRatesBody (Content: 'The rates arrive keyed BY CURRENCY CODE, so the property names are really data and no mapping can address them. A JSLT transformer rewrites the object into an array of code/value pairs, which IS a shape a mapping can address. Open the call log row to see the payload before and after. The import mapping that would turn it into rows is modelled but cannot run yet - see FINDINGS.md #23.') }
          actionbutton btnRates (
            caption: 'Get EUR rates (transformed)',
            action: microflow RestLab."ACT_Demo_Rates",
            buttonstyle: primary
          )
        }
      }
    }
  }

  container cLog (class: 'mx-spacing-top-large') {
    dynamictext dtLogTitle (Content: 'Call log')
    datagrid dgLog (
      datasource: database from RestLab."CallLog" sort by Timestamp desc,
      selection: Single
    ) {
      column colWhen (attribute: Timestamp, caption: 'When')
      column colLane (attribute: Lane, caption: 'Lane')
      column colMethod (attribute: Method, caption: 'Method')
      column colUrl (attribute: Url, caption: 'URL', WrapText: true)
      column colStatus (attribute: StatusCode, caption: 'Status', Alignment: right)
      column colMs (attribute: DurationMs, caption: 'ms', Alignment: right)
      column colOk (attribute: Success, caption: 'OK')
      column colOpen (
        Caption: 'Open',
        ShowContentAs: customContent
      ) {
        actionbutton btnOpen (
          caption: 'Detail',
          action: show_page RestLab."CallLog_Detail"(CallLog: $currentObject)
        )
      }
    }
  }
}

create or replace page RestLab."Mapped_Overview"
(
  title: 'Mapped data',
  layout: Atlas_Core.Atlas_Default
)
{
  container cObjects {
    dynamictext dtObjects (Content: 'RestObject - from api.restful-api.dev')
    datagrid dgObjects (datasource: database from RestLab."RestObject") {
      column colExtId (attribute: ExternalId, caption: 'External id')
      column colName (attribute: Name, caption: 'Name')
    }
  }
  container cProducts (class: 'mx-spacing-top-large') {
    dynamictext dtProducts (Content: 'Product - from dummyjson.com')
    datagrid dgProducts (datasource: database from RestLab."Product") {
      column colPExtId (attribute: ExternalId, caption: 'External id')
      column colTitle (attribute: Title, caption: 'Title')
      column colBrand (attribute: Brand, caption: 'Brand')
      column colPriceRaw (attribute: Price, caption: 'Price (mapped String)')
      column colPriceVal (attribute: PriceValue, caption: 'PriceValue (Decimal)', Alignment: right)
    }
  }
  container cWeather (class: 'mx-spacing-top-large') {
    dynamictext dtWeather (Content: 'WeatherReading + WeatherCurrent - the mapping that works end to end')
    datagrid dgWeather (datasource: database from RestLab."WeatherReading") {
      column colLat (attribute: Latitude, caption: 'Latitude')
      column colLon (attribute: Longitude, caption: 'Longitude')
      column colTz (attribute: Timezone, caption: 'Timezone')
      column colElev (attribute: Elevation, caption: 'Elevation')
    }
    datagrid dgCurrent (datasource: database from RestLab."WeatherCurrent") {
      column colTime (attribute: "Time", caption: 'Time')
      column colInterval (attribute: "Interval", caption: 'Interval (s)')
      column colTemp (attribute: Temperature, caption: 'Temperature')
    }
  }
  container cSPGrid (class: 'mx-spacing-top-large') {
    dynamictext dtSPGrid (Content: 'SPTaskFields - the nested SharePoint fields object, mapped onto a child entity')
    datagrid dgSP (datasource: database from RestLab."SPTaskFields") {
      column colSPTitle (attribute: Title, caption: 'Title')
      column colSPStatus (attribute: "Status", caption: 'Status')
      column colSPWho (attribute: AssignedTo, caption: 'Assigned to')
      column colSPDue (attribute: DueDate, caption: 'Due (Due_x0020_Date)')
      column colSPPrio (attribute: PriorityLevel, caption: 'Priority (Priority_x0020_Level)')
    }
  }
  container cGraphGrid (class: 'mx-spacing-top-large') {
    dynamictext dtGraphGrid (Content: 'GraphUser - mapped from GET /me, @odata.context included')
    datagrid dgGraph (datasource: database from RestLab."GraphUser") {
      column colGName (attribute: DisplayName, caption: 'Display name')
      column colGMail (attribute: Mail, caption: 'Mail')
      column colGJob (attribute: JobTitle, caption: 'Job title')
      column colGCtx (attribute: ODataContext, caption: '@odata.context', WrapText: true)
    }
  }
  container cPosts (class: 'mx-spacing-top-large') {
    dynamictext dtPosts (Content: 'Post - from jsonplaceholder')
    datagrid dgPosts (datasource: database from RestLab."Post") {
      column colPoExtId (attribute: ExternalId, caption: 'External id')
      column colPoTitle (attribute: Title, caption: 'Title', WrapText: true)
    }
  }
}
