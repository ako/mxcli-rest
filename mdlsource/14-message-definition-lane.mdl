/**
 * The message-definition lane: a contract taken FROM the domain model
 *
 * Every other mapping in this app is bound to a JSON structure -- a schema
 * written by hand (or inferred from a sample) and then matched against
 * entities. A MESSAGE DEFINITION is the other way round: it is a SELECTION
 * OVER THE DOMAIN MODEL. Every element names an entity, an attribute or an
 * association, so there is no second copy of the shape to keep in step.
 *
 * That is also why it is the only non-JSON mapping source MDL can author. An
 * XML schema is an imported .xsd and a web service is a WSDL binding; neither
 * has a spelling here. A message definition has nothing external in it.
 *
 * This lane EXPORTS, which nothing else here does: RateSnapshot and its
 * ExchangeRate children (populated by lane 09) become JSON and go out over
 * HTTP. httpbingo echoes the request back, so the generated JSON is visible
 * in the call log rather than taken on trust.
 */

-- The Lane value this uses is declared with the others in 01-domain-model.mdl.
-- (`alter enumeration ... add value if not exists` also works now -- mxcli
-- v0.21.0 added the guard this script originally needed. FINDINGS #61.)

-- ------------------------------------------------------------ 1. the contract

/**
 * A bare name is an ATTRIBUTE; Assoc/Module.Entity is an ASSOCIATION.
 *
 * Naming the association's TARGET is required, because the stored cardinality
 * follows the DIRECTION of traversal -- and, for a ReferenceSet, is a list
 * both ways. This lane was written flat at first: mxcli stored MaxOccurs 1 for
 * the forward traversal of a set and mxbuild rejected it (CE6524 + CE0295).
 * Fixed in v0.21.0, so the nested shape below is the one that was wanted all
 * along. FINDINGS #60 measured it, #61 verified the fix.
 *
 * mxcli does not pluralise an exposed name the way Studio Pro does -- it
 * defaults to the entity's own name -- so `as 'Rates'` is written out.
 */
create or modify message definition collection RestLab."MD_Rates"
  folder 'Lanes/Publish'
(
  definition "RateSnapshot" for RestLab."RateSnapshot" as 'Snapshot' (
    "Base",
    "RateDate",
    "Amount" as 'BaseAmount',
    RestLab."RateSnapshot_ExchangeRate"/RestLab."ExchangeRate" as 'Rates' (
      "Code",
      "Value"
    )
  )
);

-- ------------------------------------------------------------- 2. the mapping

/**
 * `with message definition` takes a THREE-part reference -- collection then
 * definition -- because a collection holds many definitions.
 */
create or modify export mapping RestLab."EXM_RateSnapshot"
  folder 'Lanes/Publish'
  with message definition RestLab."MD_Rates"."RateSnapshot"
{
  RestLab."RateSnapshot" {
    Base = "Base",
    RateDate = "RateDate",
    BaseAmount = "Amount",
    RestLab."RateSnapshot_ExchangeRate"/RestLab."ExchangeRate" as Rates {
      Code = "Code",
      Value = "Value"
    }
  }
};

-- ----------------------------------------------------------- 3. the microflow

/**
 * Turn one snapshot into JSON and POST it.
 *
 * The snapshot is a PARAMETER rather than a retrieve, so the export is the
 * reusable half and choosing what to publish is the caller's problem.
 */
create or modify microflow RestLab."ACT_Publish_RateSnapshot" (
  $Snapshot: RestLab."RateSnapshot"
)
returns RestLab."CallLog" as $Log
folder 'Lanes/Publish'
begin
  declare $Start DateTime = [%CurrentDateTime%];
  declare $Body String = '';
  declare $Ok Boolean = false;

  -- Domain model -> JSON, shaped by the message definition.
  $Json = export to mapping RestLab."EXM_RateSnapshot" ($Snapshot);

  $Echo = rest call post 'https://httpbingo.org/post'
    header 'Content-Type' = 'application/json'
    body '{1}' with ({1} = $Json)
    timeout 30
    returns string
    on error continue;

  IF $Echo != empty THEN
    SET $Body = $Echo;
    SET $Ok = true;
  END IF;

  $Log = CALL MICROFLOW RestLab."SUB_LogCall" (
    Url = 'POST https://httpbingo.org/post (export mapping)',
    Method = 'POST',
    StatusCode = 0,
    DurationMs = millisecondsBetween($Start, [%CurrentDateTime%]),
    Success = $Ok,
    ErrorMessage = '',
    ResponseBody = $Body,
    Lane = RestLab.Lane.Outbound
  );

  -- The generated JSON, kept beside the echo so the page can show both.
  CHANGE $Log ("TransformedBody" = $Json);
  COMMIT $Log;

  RETURN $Log;
end;
/

grant execute on microflow RestLab."ACT_Publish_RateSnapshot" to RestLab."Developer";
grant execute on microflow RestLab."ACT_Publish_RateSnapshot" to RestLab."Administrator";
